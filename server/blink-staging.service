[Unit]
Description=Blink staging API

[Service]
Type=simple
DynamicUser=yes
StateDirectory=blink-staging
ExecStart=/usr/bin/python3 -B /opt/blink-staging/api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
